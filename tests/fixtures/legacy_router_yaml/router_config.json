{
  "routes": [
    {
      "alias": "gpt-3.5-turbo",
      "targets": [
        {
          "model": "gpt-3.5-turbo",
          "provider": "openai",
          "api_key": "${OPENAI_API_KEY}",
          "tpm": 200000,
          "rpm": 2000,
          "tags": [
            "fast",
            "cost-effective"
          ],
          "metadata": {
            "deployment": "primary",
            "region": "us-east-1"
          }
        },
        {
          "model": "gpt-3.5-turbo",
          "provider": "openai",
          "api_key": "${OPENAI_API_KEY}",
          "tpm": 200000,
          "rpm": 2000,
          "tags": [
            "fast",
            "cost-effective"
          ],
          "metadata": {
            "deployment": "secondary",
            "region": "us-west-2"
          }
        }
      ],
      "strategy": "rate_limit_aware",
      "fallback_on_error": true
    },
    {
      "alias": "gpt-4",
      "targets": [
        {
          "model": "gpt-4",
          "provider": "openai",
          "api_key": "${OPENAI_API_KEY}",
          "tpm": 100000,
          "rpm": 1000,
          "tags": [
            "premium",
            "high-quality"
          ],
          "cost_per_1k_prompt_tokens": 0.03,
          "cost_per_1k_completion_tokens": 0.06
        }
      ],
      "strategy": "round_robin"
    },
    {
      "alias": "claude",
      "targets": [
        {
          "model": "claude-sonnet-4-5-20250929",
          "provider": "anthropic",
          "api_key": "${ANTHROPIC_API_KEY}",
          "tpm": 80000,
          "rpm": 800,
          "tags": [
            "anthropic",
            "claude"
          ]
        },
        {
          "model": "claude-sonnet-4-5-20250929",
          "provider": "anthropic",
          "api_key": "${ANTHROPIC_API_KEY_SECONDARY}",
          "tpm": 80000,
          "rpm": 800,
          "tags": [
            "anthropic",
            "claude"
          ]
        }
      ],
      "strategy": "least_busy"
    },
    {
      "alias": "azure-gpt4",
      "targets": [
        {
          "model": "gpt-4",
          "provider": "azure",
          "api_key": "${AZURE_OPENAI_API_KEY_EAST}",
          "api_base": "${AZURE_API_BASE_EAST}",
          "api_version": "2024-02-15-preview",
          "region": "eastus",
          "tpm": 100000,
          "rpm": 1000,
          "metadata": {
            "location": "Virginia",
            "priority": "primary"
          }
        },
        {
          "model": "gpt-4",
          "provider": "azure",
          "api_key": "${AZURE_OPENAI_API_KEY_WEST}",
          "api_base": "${AZURE_API_BASE_WEST}",
          "api_version": "2024-02-15-preview",
          "region": "westus",
          "tpm": 100000,
          "rpm": 1000,
          "metadata": {
            "location": "Oregon",
            "priority": "secondary"
          }
        }
      ],
      "strategy": "latency_based"
    },
    {
      "alias": "budget",
      "targets": [
        {
          "model": "gpt-3.5-turbo",
          "provider": "openai",
          "api_key": "${OPENAI_API_KEY}",
          "tpm": 200000,
          "rpm": 2000,
          "cost_per_1k_prompt_tokens": 0.0005,
          "cost_per_1k_completion_tokens": 0.0015,
          "tags": [
            "budget",
            "fast"
          ]
        },
        {
          "model": "gpt-3.5-turbo-16k",
          "provider": "openai",
          "api_key": "${OPENAI_API_KEY}",
          "tpm": 180000,
          "rpm": 1800,
          "cost_per_1k_prompt_tokens": 0.001,
          "cost_per_1k_completion_tokens": 0.002,
          "tags": [
            "budget",
            "large-context"
          ]
        }
      ],
      "strategy": "cost_based"
    },
    {
      "alias": "weighted-gpt4",
      "targets": [
        {
          "model": "gpt-4",
          "provider": "openai",
          "api_key": "${OPENAI_API_KEY}",
          "tpm": 100000,
          "rpm": 1000,
          "weight": 80,
          "metadata": {
            "deployment": "stable"
          }
        },
        {
          "model": "gpt-4-turbo-preview",
          "provider": "openai",
          "api_key": "${OPENAI_API_KEY}",
          "tpm": 50000,
          "rpm": 500,
          "weight": 20,
          "metadata": {
            "deployment": "canary"
          }
        }
      ],
      "strategy": "weighted"
    },
    {
      "alias": "priority-claude",
      "targets": [
        {
          "model": "claude-3-opus-20240229",
          "provider": "anthropic",
          "api_key": "${ANTHROPIC_API_KEY}",
          "priority": 100,
          "tpm": 80000,
          "rpm": 800,
          "metadata": {
            "tier": "primary"
          }
        },
        {
          "model": "claude-sonnet-4-5-20250929",
          "provider": "anthropic",
          "api_key": "${ANTHROPIC_API_KEY}",
          "priority": 50,
          "tpm": 80000,
          "rpm": 800,
          "metadata": {
            "tier": "secondary"
          }
        },
        {
          "model": "claude-3-haiku-20240307",
          "provider": "anthropic",
          "api_key": "${ANTHROPIC_API_KEY}",
          "priority": 10,
          "tpm": 100000,
          "rpm": 1000,
          "metadata": {
            "tier": "tertiary"
          }
        }
      ],
      "strategy": "priority_based"
    },
    {
      "alias": "bedrock-claude",
      "targets": [
        {
          "model": "us.anthropic.claude-sonnet-4-5-20250929-v1:0",
          "provider": "bedrock",
          "region": "us-east-1",
          "metadata": {
            "location": "Virginia"
          }
        },
        {
          "model": "us.anthropic.claude-sonnet-4-5-20250929-v1:0",
          "provider": "bedrock",
          "region": "us-west-2",
          "metadata": {
            "location": "Oregon"
          }
        },
        {
          "model": "eu.anthropic.claude-sonnet-4-5-20250929-v1:0",
          "provider": "bedrock",
          "region": "eu-west-1",
          "metadata": {
            "location": "Ireland"
          }
        }
      ],
      "strategy": "latency_based"
    },
    {
      "alias": "random",
      "targets": [
        {
          "model": "gpt-3.5-turbo",
          "provider": "openai",
          "api_key": "${OPENAI_API_KEY}"
        },
        {
          "model": "claude-3-haiku-20240307",
          "provider": "anthropic",
          "api_key": "${ANTHROPIC_API_KEY}"
        }
      ],
      "strategy": "simple_shuffle"
    }
  ],
  "fallbacks": [
    {
      "primary": "gpt-4",
      "fallbacks": [
        "azure-gpt4",
        "claude"
      ]
    },
    {
      "primary": "claude",
      "fallbacks": [
        "bedrock-claude",
        "gpt-4"
      ]
    },
    {
      "primary": "azure-gpt4",
      "fallbacks": [
        "gpt-4",
        "gpt-3.5-turbo"
      ]
    },
    {
      "primary": "budget",
      "fallbacks": [
        "gpt-3.5-turbo"
      ]
    }
  ],
  "retry_policies": [
    {
      "error_type": "RateLimitError",
      "max_retries": 3,
      "retry_after_seconds": 5,
      "exponential_backoff": true
    },
    {
      "error_type": "TimeoutError",
      "max_retries": 2,
      "retry_after_seconds": 3,
      "exponential_backoff": true
    },
    {
      "error_type": "ServerError",
      "max_retries": 2,
      "retry_after_seconds": 5,
      "exponential_backoff": true
    },
    {
      "error_type": "AuthenticationError",
      "max_retries": 0
    }
  ],
  "allowed_fails_policies": [
    {
      "error_type": "RateLimitError",
      "allowed_fails_per_minute": 100
    },
    {
      "error_type": "TimeoutError",
      "allowed_fails_per_minute": 50
    },
    {
      "error_type": "ServerError",
      "allowed_fails_per_minute": 20
    }
  ],
  "strategy": "rate_limit_aware",
  "cooldown_seconds": 60.0,
  "enable_pre_call_checks": true
}
