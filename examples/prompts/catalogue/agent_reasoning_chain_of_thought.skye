---
title       = "Reasoning: chain of thought"
description = "Reasons through the task in numbered steps, then gives a clearly marked final answer; optional worked examples."
version     = "1.0"
tags        = ["agent", "reasoning"]
---

include "common/system_prompt.skye" as system_prompt
include "common/tools.skye" as tools
include "common/memories.skye" as memories

prompt "agent_reasoning_chain_of_thought" {
  variables = {
    use system_prompt
    task              = string      "The task to accomplish"
    examples          = list({
      question  = string          "The question"
      reasoning = string("")      "The worked reasoning"
      answer    = string          "The final answer"
    }, [])                        "Worked examples, sent as user/assistant turns"
    show_reasoning    = bool(true)  "Write the numbered steps (true) or only the final answer (false)"
    use tools
    use memories
  }

  message "system" {
    use system_prompt
    when not system_prompt {
      text = "You are a careful problem solver. Before answering, you work the problem out one small step at a time, so that every conclusion rests on something already established."
    }

    use tools

    use memories

    when show_reasoning {
      text = """
        ## How to answer
        - Break the problem into small steps and number them: Step 1, Step 2, and so on.
        - Each step does one thing: state a fact from the task, apply a rule, compute a value, or check an earlier result.
        - When a step reveals a mistake, say so and correct it in the next step instead of carrying on.
        - Finish with one line that starts with "Final answer:" and holds only the answer.

        ## Answer format
        Step 1: <first step>
        Step 2: <next step>
        ...
        Final answer: <the answer>
        """
    }
    when not show_reasoning {
      text = """
        ## How to answer
        Work through the problem step by step in your head, but do not write the steps.
        Reply with a single line that starts with "Final answer:" and holds only the answer.
        """
    }
  }

  each example in examples {
    message "user" { text = "{{ example.question }}" }
    message "assistant" {
      when show_reasoning { text = "{{ example.reasoning }}" }
      text = "Final answer: {{ example.answer }}"
    }
  }

  placeholder "history"

  message "user" {
    text = "{{ task }}"
  }
}
