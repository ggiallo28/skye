---
title       = "Procedure agent"
description = "An agent that picks one procedure (or none) for the user's request and answers with a JSON action; takes the procedures, examples, tools and memories."
version     = "1.0"
tags        = ["agent", "procedure", "json"]
---

include "common/system_prompt.skye" as system_prompt
include "common/tools.skye" as tools
from "common/memories.skye" import persona_memory, episodic_memory, semantic_memory, procedural_memory, working_memory

prompt "agent_procedure" {
  variables = {
    use system_prompt
    examples = list({
      question     = string      "Example request"
      action       = string      "Procedure chosen, or no_action"
      action_input = string("")  "Input given to it"
    }, []) "Worked examples"
    input         = string("")  "The user's message"
    use tools
    use persona_memory
    use episodic_memory
    use semantic_memory
    use procedural_memory
    use working_memory
  }

  message "system" {
    use system_prompt
    when not system_prompt {
      text = "You are an intelligent AI assistant that can execute procedures and forms to help users complete complex tasks. You have access to various procedures and should select the most appropriate one based on the user's request."
    }

    text = "You have access to the following procedures:"
    each procedure in procedural_memory {
      when procedure.name {
        text = "- \"{{ procedure.name }}\": {{ procedure.content }}"
        each step in procedure.steps { text = "  * {{ step }}" }
      }
    }
    use tools

    when episodic_memory or semantic_memory or persona_memory or working_memory {
      text = "## Memory"
      when persona_memory {
        text = "### Persona"
        each m in persona_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when episodic_memory {
        text = "### Past events"
        each m in episodic_memory {
          when m.timestamp     { text = "- [{{ m.timestamp }}] {{ m.content }}" }
          when not m.timestamp { text = "- {{ m.content }}" }
        }
      }
      when semantic_memory {
        text = "### Known facts"
        each m in semantic_memory {
          when m.source     { text = "- {{ m.content }} (source: {{ m.source }})" }
          when not m.source { text = "- {{ m.content }}" }
        }
      }
      when working_memory {
        text = "### Current notes"
        each m in working_memory {
          when m.name     { text = "- {{ m.name }}: {{ m.content }}" }
          when not m.name { text = "- {{ m.content }}" }
        }
      }
    }

    text = """
      ## Response Format

      Please respond with a JSON object containing the procedure to execute:

      ```json
      {
          "action": "procedure_name",
          "action_input": "input_for_procedure"
      }
      ```

      If no procedure is needed, respond with:
      ```json
      {
          "action": "no_action",
          "action_input": null
      }
      ```
      """

    when examples {
      text = "## Examples:"
      each example in examples {
        text = """
          Question: {{ example.question }}
          ```json
          {
              "action": "{{ example.action }}",
              "action_input": "{{ example.action_input }}"
          }
          ```
          """
      }
    }

    text = "{{ '## Relevant procedures from memory:' if '' in (procedural_memory | map('name')) else '' }}"
    each memory in procedural_memory {
      when not memory.name { text = "- {{ memory.content }}" }
    }
  }
  placeholder "history"

  message "user" {
    text = "{{ input }}"
    text = "Please select the most appropriate procedure to help with this request."
  }
}
