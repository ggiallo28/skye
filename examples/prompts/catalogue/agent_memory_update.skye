---
title       = "Memory update"
description = "Reads the conversation and the memories already kept, then says what to add, change or forget, as JSON operations."
version     = "1.0"
tags        = ["agent", "memory"]
---

include "common/system_prompt.skye" as system_prompt
include "common/tools.skye" as tools
include "common/memories.skye" as memories

prompt "agent_memory_update" {
  variables = {
    use system_prompt
    use tools
    transcript        = list({
      speaker = string            "Who spoke"
      content = string            "What they said"
    }, [])                        "Conversation so far"
    latest_exchange   = string("")        "The latest turns as plain text; when empty, the messages above are used"
    timestamp         = string("")        "Current time, given to new episodic memories"
    use memories
    kinds             = list(string, [])  "Memory kinds that may change: persona, episodic, semantic, procedural, working"
    max_operations    = number(0)         "Maximum number of operations; 0 means no limit"
    user_name         = string("")        "Name of the user"
    agent_name        = string("")        "Name of the agent whose memory is kept"
  }

  message "system" {
    use system_prompt
    when not system_prompt {
      text = "You look after the long-term memory of an agent. You do not answer the user: you read the conversation, compare it with what the agent already remembers, and decide which memories to add, change or remove so that the agent knows more next time."
    }
    when agent_name { text = "The agent whose memory you keep is called {{ agent_name }}." }
    when user_name  { text = "The user in the conversation is called {{ user_name }}." }

    when tools {
      text = "## Tools"
      text = "These tools exist in the system. You do not call them here, but a procedure or a note may mention them."
      each tool in tools {
        text = "- **{{ tool.name }}**: {{ tool.description }}"
        when "parameters" in tool and tool.parameters { text = "  Parameters: {{ tool.parameters | tojson }}" }
        when "returns" in tool and tool.returns       { text = "  Returns: {{ tool.returns }}" }
      }
    }

    use memories
    when persona_memory or episodic_memory or semantic_memory or procedural_memory or working_memory {
      text = "An item that has an id shows it first, in square brackets; refer to the item by that id."
    }

    text = """
      ## Kinds of memory
      - persona: who the user or the agent is, and lasting preferences (language, tone, likes and dislikes).
      - episodic: something that happened in the conversation, worth recalling later as an event; give it the current time when one is given.
      - semantic: a durable fact about the world, the user's situation or their projects, true beyond this conversation.
      - procedural: a way of doing something that worked; give it a short name and the steps in order.
      - working: a note that only matters for the task in progress and can be dropped once it is finished.

      ## How to decide
      - Write each memory as one atomic fact that makes sense on its own, without the conversation around it: name people and things instead of saying "he" or "it".
      - When something new refines or changes a memory that already exists, update that memory by its id instead of adding a near-copy.
      - Delete a memory, by its id, when the conversation shows it is wrong or out of date, or when the user asks you to forget it.
      - Never store passwords, keys, tokens, card numbers or other secrets, and skip small talk and greetings that say nothing lasting.
      - Store only what the conversation actually says or clearly implies; do not guess.
      - Use "none" only when you want to explain why a tempting item was left out; otherwise just leave it out.
      """
    when kinds { text = "Only propose operations for these kinds: {{ kinds | join(', ') }}. Leave every other kind as it is." }
    when max_operations { text = "Propose at most {{ max_operations }} operations; keep the most useful ones." }
    text = """
      ## Answer format
      Reply with one JSON object and nothing else. Each operation has:
      - "op": "add", "update", "delete" or "none"
      - "kind": "persona", "episodic", "semantic", "procedural" or "working"
      - "id": the id of the existing memory, for "update" and "delete" (leave it out for "add")
      - "content": the full text of the memory after the change (not needed for "delete")
      - "name" and "steps": only for procedural memories, the name of the procedure and its steps as a list of strings
      - "reason": why, in one short sentence
      Example:
      {"operations": [{"op": "update", "kind": "persona", "id": "p1", "content": "The user prefers answers in Italian.", "reason": "The user asked to switch from English to Italian."}, {"op": "add", "kind": "procedural", "content": "Deploying the docs site", "name": "deploy_docs", "steps": ["run the build", "upload the output folder"], "reason": "These steps worked in this conversation."}]}
      When there is nothing worth remembering, reply {"operations": []}.
      """
  }

  placeholder "history"

  message "user" {
    when timestamp { text = "Current time: {{ timestamp }}" }
    when transcript {
      text = "## Conversation"
      each turn in transcript { text = "{{ turn.speaker }}: {{ turn.content }}" }
    }
    when latest_exchange {
      text = "## Latest exchange"
      text = "{{ latest_exchange }}"
    }
    when not (transcript or latest_exchange) { text = "The conversation is in the messages above." }
    text = "What should the agent remember from this conversation?"
  }
}
