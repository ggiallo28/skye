{
  "input": "Notebooks cost 4.50 EUR and are in stock; pens cost 1.20 EUR, sold out.",
  "instructions": [
    "List every product with its price."
  ],
  "format": "table",
  "schema": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "price": {
      "type": "number",
      "description": "Unit price in EUR"
    },
    "in_stock": "bool"
  },
  "examples": [
    {
      "input": "Pens, 1.20 EUR each, in stock.",
      "output": "| name | price | in_stock |\n| --- | --- | --- |\n| Pens | 1.2 | true |"
    }
  ]
}
