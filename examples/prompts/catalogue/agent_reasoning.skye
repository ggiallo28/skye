---
title       = "Reasoning agent"
description = "A step-by-step reasoning assistant; takes the reasoning type, context, constraints, examples, output layout, tools and memories."
version     = "1.0"
tags        = ["agent", "reasoning"]
---

include "common/system_prompt.skye" as system_prompt
include "common/tools.skye" as tools
include "common/memories.skye" as memories

prompt "agent_reasoning" {
  variables = {
    use system_prompt
    reasoning_type = string("")        "chain_of_thought, tree_of_thought, analytical or creative"
    context        = string("")        "Background for the problem"
    constraints    = list(string, [])  "Limits to respect"
    examples = list({
      problem   = string      "Example problem"
      reasoning = string("")  "How it was reasoned through"
      solution  = string      "The solution reached"
    }, []) "Worked examples"
    input          = string("")        "The user's message"
    output_format  = string("")        "structured, json, or empty for a plain explanation"
    use tools
    use memories
  }

  message "system" {
    use system_prompt
    when not system_prompt {
      text = "You are an intelligent reasoning assistant that can break down complex problems, analyze information, and provide step-by-step solutions. You think through problems methodically and explain your reasoning clearly."
    }

    when reasoning_type {
      text = "## Reasoning Type: {{ reasoning_type }}"
      when reasoning_type == "chain_of_thought" { text = "Please think through this step by step, showing your reasoning process." }
      when reasoning_type == "tree_of_thought"  { text = "Please explore multiple reasoning paths and evaluate the best approach." }
      when reasoning_type == "analytical"       { text = "Please provide a structured analytical breakdown of the problem." }
      when reasoning_type == "creative"         { text = "Please approach this problem creatively, considering unconventional solutions." }
    }

    when context {
      text = "## Context:"
      text = "{{ context }}"
    }

    when constraints {
      text = "## Constraints:"
      each constraint in constraints { text = "- {{ constraint }}" }
    }

    when examples {
      text = "## Examples of similar reasoning:"
      each example in examples {
        text = "**Problem:** {{ example.problem }}"
        text = "**Reasoning:** {{ example.reasoning }}"
        text = "**Solution:** {{ example.solution }}"
      }
    }
    use tools
    use memories

  }
  placeholder "history"

  message "user" {
    text = "{{ input }}"

    when output_format == "structured" {
      text = """
        Please structure your response as follows:
        1. **Problem Analysis**: Break down the problem
        2. **Key Considerations**: Important factors to consider
        3. **Reasoning Steps**: Step-by-step thought process
        4. **Solution**: Your recommended approach
        5. **Confidence**: How confident you are in this solution (1-10)
        """
    }
    when output_format == "json" {
      text = """
        Please format your response as JSON:
        ```json
        {
            "problem_analysis": "breakdown of the problem",
            "reasoning_steps": ["step 1", "step 2", "step 3"],
            "solution": "your recommended solution",
            "confidence": 0.0,
            "alternative_approaches": ["approach 1", "approach 2"]
        }
        ```
        """
    }
    when output_format != "structured" and output_format != "json" {
      text = "Please think through this carefully and explain your reasoning."
    }
  }
}
