---
title       = "Text explanation"
description = "Explain a topic for a given audience level and explanation type, with optional context, examples and specific aspects to cover."
version     = "1.0"
tags        = ["explanation", "education"]
---

include "common/system_prompt.skye" as system_prompt

prompt "text_explanation" {
  variables = {
    use system_prompt
    description      = string("")  "Extra task description, shown after the role sentence"
    audience_level   = string("")  "beginner, intermediate, expert or child; other values are only named"
    explanation_type = string("")  "step_by_step, conceptual, practical or comparative"
    context          = string("")  "Background for the explanation"
    examples = list({
      topic       = string  "Example topic"
      explanation = string  "How it was explained"
    }, []) "Worked examples"
    topic            = string            "The topic to explain"
    specific_aspects = list(string, [])  "Aspects to cover"
    output_format    = string("")  "structured, json, or empty for a plain explanation"
  }

  message "system" {
    use system_prompt
    when not system_prompt { text = "You are an intelligent explanation system. You can break down complex topics, concepts, or processes into clear, understandable explanations tailored to the audience's level of understanding." }
    when description { text = "{{ description }}" }
    when audience_level {
      text = "## Audience Level: {{ audience_level }}"
      when audience_level == "beginner"     { text = "Please explain in simple terms, avoiding technical jargon." }
      when audience_level == "intermediate" { text = "Please provide a balanced explanation with some technical details." }
      when audience_level == "expert"       { text = "Please provide a detailed, technical explanation." }
      when audience_level == "child"        { text = "Please explain as if talking to a child, using simple language and analogies." }
    }
    when explanation_type {
      text = "## Explanation Type: {{ explanation_type }}"
      when explanation_type == "step_by_step" { text = "Please break this down into clear, sequential steps." }
      when explanation_type == "conceptual"   { text = "Please focus on the underlying concepts and principles." }
      when explanation_type == "practical"    { text = "Please focus on practical applications and real-world examples." }
      when explanation_type == "comparative"  { text = "Please explain by comparing to similar or contrasting concepts." }
    }
    when context {
      text = "## Context:"
      text = "{{ context }}"
    }
    when examples {
      text = "## Examples:"
      each example in examples {
        text = "**Topic:** {{ example.topic }}"
        text = "**Explanation:** {{ example.explanation }}"
      }
    }
    text = "## Topic to Explain:"
    text = "{{ topic }}"
    when specific_aspects {
      text = "## Specific Aspects to Cover:"
      each aspect in specific_aspects { text = "- {{ aspect }}" }
    }
    when output_format == "structured" {
      text = "Please structure your explanation as follows:"
      text = "1. **Overview**: Brief introduction to the topic"
      text = "2. **Key Concepts**: Main ideas or principles"
      text = "3. **Detailed Explanation**: In-depth breakdown"
      text = "4. **Examples**: Real-world applications or examples"
      text = "5. **Summary**: Key takeaways"
    }
    when output_format == "json" {
      text = "Please format your response as JSON:"
      text = "```json"
      text = "{"
      text = "  \"overview\": \"brief introduction\","
      text = "  \"key_concepts\": [\"concept1\", \"concept2\"],"
      text = "  \"detailed_explanation\": \"in-depth explanation\","
      text = "  \"examples\": [\"example1\", \"example2\"],"
      text = "  \"summary\": \"key takeaways\""
      text = "}"
      text = "```"
    }
    when output_format != "structured" and output_format != "json" {
      text = "Please provide a clear, comprehensive explanation."
    }
  }
}
