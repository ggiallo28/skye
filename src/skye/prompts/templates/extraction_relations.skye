---
title       = "Relation extraction"
description = "Extract relations between entities in a text for the given relation types, with optional examples; output as JSON, triplets or a list."
version     = "1.0"
tags        = ["relation", "extraction", "nlp"]
---

include "common/system_prompt.skye" as system_prompt

prompt "extraction_relations" {
  variables = {
    use system_prompt
    description    = string("")  "Extra task description, shown after the role sentence"
    domain         = string("")  "Domain to focus on; empty for none"
    relation_types = list({
      name        = string            "Relation type, e.g. WORKS_FOR"
      description = string("")        "What it means"
      examples    = list(string, [])  "Example mentions"
    }, []) "Relation types; empty for common defaults"
    examples = list({
      text      = string  "Example text"
      relations = string  "Relations found in it, as written in the answer"
    }, []) "Worked examples"
    text           = string("")  "The text to analyse"
    output_format  = string("")  "json, triplets, or empty for plain text"
  }

  message "system" {
    use system_prompt
    when not system_prompt {
      text = "You are an intelligent relation extraction system. You analyze text to identify and extract relationships between entities, providing structured information about how entities are connected."
    }
    when description { text = "{{ description }}" }
    when domain {
      text = "## Domain: {{ domain }}"
      text = "Please focus on relationships relevant to the {{ domain }} domain."
    }

    when relation_types {
      text = "## Relation Types to Extract:"
      each relation in relation_types {
        text = "- **{{ relation.name }}**: {{ relation.description }}"
        when relation.examples { text = "Examples: {{ relation.examples | join(', ') }}" }
      }
    }
    when not relation_types {
      text = """
        ## Common Relation Types:
        - **WORKS_FOR**: Person works for an organization
        - **LOCATED_IN**: Entity is located in a place
        - **PART_OF**: Entity is part of another entity
        - **FOUNDED_BY**: Organization founded by person
        - **MARRIED_TO**: Person married to another person
        """
    }

    when examples {
      text = "## Examples:"
      each example in examples {
        text = "**Text:** {{ example.text }}"
        text = "**Relations:** {{ example.relations }}"
      }
    }

    text = "## Text to Analyze:"
    text = "{{ text }}"

    when output_format == "json" {
      text = """
        Please format your response as JSON:
        ```json
        {
          "relations": [
            {
              "subject": "entity1",
              "relation": "RELATION_TYPE",
              "object": "entity2",
              "confidence": 0.0
            }
          ]
        }
        ```
        """
    }
    when output_format == "triplets" { text = "Please format as triplets: (subject, relation, object)" }
    when output_format != "json" and output_format != "triplets" { text = "## Extracted Relations:" }
  }
}
