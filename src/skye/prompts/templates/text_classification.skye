---
title       = "Text classification"
description = "Classify a text into one of the given categories, with optional category descriptions, examples, confidence score, reasoning and JSON output."
version     = "1.0"
tags        = ["classification", "nlp"]
---

include "common/system_prompt.skye" as system_prompt

prompt "text_classification" {
  variables = {
    use system_prompt
    description         = string("")   "Extra task description, shown after the role sentence"
    domain              = string("")   "Domain to classify within; empty for none"
    categories = list({
      name        = string      "Category name"
      description = string("")  "What it means"
    }, []) "Categories to choose from"
    examples = list({
      text      = string      "Example text"
      category  = string      "Its category"
      reasoning = string("")  "Why it belongs there"
    }, []) "Worked examples"
    text                = string("")   "The text to classify"
    confidence_required = bool(false)  "Also ask for a confidence score between 0.0 and 1.0"
    reasoning_required  = bool(false)  "Also ask to explain the classification"
    output_format       = string("")   "json, or empty for a plain Category/Confidence/Reasoning block"
  }

  message "system" {
    use system_prompt
    when not system_prompt { text = "You are an intelligent text classification system. You analyze text and classify it into predefined categories with high accuracy." }
    when description { text = "{{ description }}" }
    when domain {
      text = "## Domain: {{ domain }}"
      text = "Please classify within the context of {{ domain }}."
    }
    text = "## Classification Task:"
    text = "Classify the following text into one of these categories: {{ categories | map('name') | join(', ') }}."
    when categories {
      text = "## Category Descriptions:"
      each category in categories {
        when category.description     { text = "- **{{ category.name }}**: {{ category.description }}" }
        when not category.description { text = "- **{{ category.name }}**" }
      }
    }
    when examples {
      text = "## Examples:"
      each example in examples {
        text = "**Text:** \"{{ example.text }}\""
        text = "**Category:** {{ example.category }}"
        when example.reasoning { text = "**Reasoning:** {{ example.reasoning }}" }
      }
    }
    text = "## Text to Classify:"
    text = "\"{{ text }}\""
    when confidence_required { text = "Please also provide a confidence score between 0.0 and 1.0." }
    when reasoning_required  { text = "Please explain your reasoning for the classification." }
    when output_format == "json" {
      text = "Please format your response as JSON:"
      text = "```json"
      text = "{"
      when confidence_required or reasoning_required         { text = "  \"category\": \"selected_category\"," }
      when not confidence_required and not reasoning_required { text = "  \"category\": \"selected_category\"}" }
      when confidence_required and reasoning_required     { text = "  \"confidence\": 0.0," }
      when confidence_required and not reasoning_required { text = "  \"confidence\": 0.0}" }
      when reasoning_required { text = "  \"reasoning\": \"explanation for the classification\"}" }
      text = "```"
    }
    when output_format != "json" {
      text = "## Classification Result:"
      text = "Category:"
      when confidence_required { text = "Confidence:" }
      when reasoning_required  { text = "Reasoning:" }
    }
  }
}
