---
title       = "SQL generation"
description = "Turn a natural-language question into SQL from a database schema and type, with optional examples and constraints; output as SQL, explained SQL or JSON."
version     = "1.0"
tags        = ["sql", "code", "generation"]
---

include "common/system_prompt.skye" as system_prompt

prompt "generation_sql" {
  variables = {
    use system_prompt
    description     = string("")  "Extra task description, shown after the role sentence"
    database_schema = list({
      name        = string      "Table name"
      description = string("")  "What the table holds"
      columns     = list({
        name        = string      "Column name"
        type        = string      "SQL type"
        description = string("")  "What the column holds"
      }, []) "Columns of the table"
    }, []) "Tables"
    database_type   = string("")        "SQL dialect, e.g. PostgreSQL; empty for any"
    examples = list({
      question = string  "Example question"
      sql      = string  "Its SQL query"
    }, []) "Worked examples"
    constraints     = list(string, [])  "Limits to respect"
    question        = string("")  "The question to translate into SQL"
    output_format   = string("")  "explained, json, or empty for query plus explanation"
  }

  message "system" {
    use system_prompt
    when not system_prompt {
      text = "You are an expert SQL query generator. You can translate natural language questions into accurate, efficient SQL queries based on the provided database schema."
    }
    when description { text = "{{ description }}" }

    when database_schema {
      text = "## Database Schema:"
      each table in database_schema {
        text = "**Table: {{ table.name }}**"
        when table.description { text = "Description: {{ table.description }}" }
        text = "Columns:"
        each column in table.columns {
          when column.description     { text = "- {{ column.name }} ({{ column.type }}) - {{ column.description }}" }
          when not column.description { text = "- {{ column.name }} ({{ column.type }})" }
        }
      }
    }

    when database_type {
      text = "## Database Type: {{ database_type }}"
      text = "Please generate queries compatible with {{ database_type }}."
    }

    when examples {
      text = "## Examples:"
      each example in examples {
        text = """
          **Question:** {{ example.question }}
          **SQL:**
          ```sql
          {{ example.sql }}
          ```
          """
      }
    }

    when constraints {
      text = "## Constraints:"
      each constraint in constraints { text = "- {{ constraint }}" }
    }

    text = "## Question:"
    text = "{{ question }}"

    when output_format == "explained" {
      text = """
        Please provide:
        1. **SQL Query**: The complete SQL query
        2. **Explanation**: How the query works
        3. **Key Joins**: Important table relationships used
        4. **Performance Notes**: Any performance considerations
        """
    }
    when output_format == "json" {
      text = """
        Please format your response as JSON:
        ```json
        {
          "sql": "SELECT * FROM table WHERE condition",
          "explanation": "explanation of the query",
          "tables_used": ["table1", "table2"],
          "complexity": "simple|medium|complex"
        }
        ```
        """
    }
    when output_format != "explained" and output_format != "json" {
      text = """
        ## SQL Query:
        ```sql

        ```

        ## Explanation:
        """
    }
  }
}
